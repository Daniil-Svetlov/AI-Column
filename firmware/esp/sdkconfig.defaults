# ESP32-S3-DevKitC-1 N16R8: 16 МБ Flash (QIO), 8 МБ Octal PSRAM
# Таблицу разделов (partitions.csv, приложение до 6 МБ) записывает espflash — см. runner в .cargo/config.toml
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# большие буферы (звук, кадр экрана) — в PSRAM, мелочь — во внутренней памяти
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20000
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Wi-Fi без энергосбережения — звук идёт ровнее
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
CONFIG_LWIP_IGMP=y
