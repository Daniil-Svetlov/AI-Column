# Скопируй в .env и заполни. Этот файл в git не попадает.

# Общий секрет для колонки и веб-панели (тот же — в firmware/include/secrets.h)
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
AUTH_TOKEN=

PORT=8080

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Локальные модели (OpenAI-совместимые серверы)
OLLAMA_URL=http://localhost:11434/v1
KIMI_URL=http://localhost:8001/v1
KIMI_API_KEY=
KIMI_MODEL=moonshotai/Kimi-K2-Instruct

# Речь
STT_URL=http://localhost:8000/v1
STT_API_KEY=
TTS_URL=http://localhost:5000
