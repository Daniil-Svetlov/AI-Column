{
  "name": "ai-column-server",
  "version": "0.1.0",
  "private": true,
  "description": "Сервер умной колонки AI-Column: речь → агенты (Claude, Qwen, Kimi и др.) → речь",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.12"
  },
